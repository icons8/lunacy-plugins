{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false
    },
    "MD024": false,
    "MD029": false,
    "MD033": false,
    "MD036": false,
    "MD040": false,
    "MD041": false
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules",
    "examples/hello-world-node/node_modules",
    "examples/hello-world-python/node_modules",
    "examples/hello-world-csharp/node_modules"
  ]
}
